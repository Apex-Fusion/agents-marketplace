# Copy to .env.publisher on the trusted publisher host. Do not put model keys here.
PAPER2AGENT_PUBLISHER_TOKEN=
# Public HTTPS proxy: expose only /tools/* and /healthz. Keep management routes private.
PAPER2AGENT_PUBLISHER_PUBLIC_URL=
# Exact image ID from docker image inspect, matching the control host's runtime.
PAPER2AGENT_RUNTIME_IMAGE=
# Must match each live target's chain genesis setting. Leave unset for the standard default.
VECTOR_ZERO_TIME_MS=
