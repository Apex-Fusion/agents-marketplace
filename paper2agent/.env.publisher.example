# Copy to .env.publisher on the trusted publisher host. Do not put model keys here.
PAPER2AGENT_PUBLISHER_TOKEN=
# Optional bearer token for unpaid tool calls (POST /tools/<id>/v1/paper2agent/call).
# Set the same value as the gateway's PAPER2AGENT_TOOL_CALL_TOKEN: openssl rand -hex 32.
# It must differ from PAPER2AGENT_PUBLISHER_TOKEN. Leave empty to disable the route (404).
PAPER2AGENT_TOOL_CALL_TOKEN=
# Public HTTPS proxy: expose only /tools/* and /healthz. Keep management routes private.
PAPER2AGENT_PUBLISHER_PUBLIC_URL=
# Exact image ID from docker image inspect, matching the control host's runtime.
PAPER2AGENT_RUNTIME_IMAGE=
# Must match each live target's chain genesis setting. Leave unset for the standard default.
VECTOR_ZERO_TIME_MS=
# Slot identity records (Part 2 §9.2): the Foundation controller public key (its
# private key stays offline) and the Accountable Party ("controller" or a 56-hex key
# hash). Unset: the publisher registers no slot record. A slot with IDENTITY_POLICY_ID
# in the targets file also needs IDENTITY_REF_UTXO there, and may set AGENT_ID,
# IDENTITY_ESCROW_REF_UTXO and IDENTITY_ADVERT_REF_UTXO. A slot that already has a legacy
# advert gets its identity advert with POST /targets/<id>/readvert once its record exists,
# then switch and retire-legacy at the escrow switch. These need no setting here; see
# docs/DEPLOY_NEW_SUPPLIER.md (Re-advertise published slots for the identity release).
IDENTITY_CONTROLLER_PUB_KEY_HEX=
IDENTITY_ACCOUNTABLE_PARTY=
