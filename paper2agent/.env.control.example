# Copy to .env.control on the isolated build host. Do not put wallet keys here.
# Generate a new random token, for example with openssl rand -hex 32.
PAPER2AGENT_CONTROL_TOKEN=
# Build model calls: the buyer app's paid endpoint, an advertised llm.text.generate.v1
# model, and the same token as PAPER2AGENT_MODEL_TOKEN in buyer/.env. Each call buys
# one marketplace escrow from the buyer wallet.
PAPER2AGENT_MODEL_BASE_URL=https://marketplace.vector.apexfusion.org/v1/paper2agent/model
PAPER2AGENT_MODEL=gpt-5.6-sol
PAPER2AGENT_MODEL_API_KEY=
# Build runtime.Dockerfile once. Load that exact image on both hosts.
PAPER2AGENT_RUNTIME_IMAGE=vector-paper2agent-runtime:local
# Optional private publisher URL and its management token; set both or neither.
PAPER2AGENT_PUBLISHER_URL=
PAPER2AGENT_PUBLISHER_TOKEN=
