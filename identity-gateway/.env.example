# identity-gateway runtime settings. All are optional; the values below are the defaults.
# Identity registry values are published at its deployment. A deployed registry needs both
# IDENTITY_POLICY_ID and CUTOFF_SLOT. IDENTITY_ADDRESS defaults to the enterprise address of the policy.
IDENTITY_POLICY_ID=
IDENTITY_ADDRESS=
CUTOFF_SLOT=
LEGACY_POLICY_ID=be1a0a2912da180757ed3cd61b56bb8eab0188c19dc3c0e3912d2c01
LEGACY_ADDRESS=addr1wxlp5z3fztdpsp6ha57dvx6khw82kqvgcxwu8s8rjykjcqghprf42
# Vector mainnet genesis values. The resolver compares them with the values Koios reports.
GENESIS_NETWORK_MAGIC=764824073
GENESIS_SYSTEM_START=2025-08-29T16:40:00Z
GENESIS_SLOT_LENGTH=1
GENESIS_SECURITY_PARAM=2160
KOIOS_URL=https://v2.koios.vector.mainnet.apexfusion.org/api/v1
# Koios bearer token, if the Koios instance needs one. Do not commit a real token.
KOIOS_TOKEN=
OGMIOS_URL=wss://ogmios.vector.mainnet.apexfusion.org
HOST=127.0.0.1
PORT=8080
# Public HTTPS origin of the gateway, the only base URL: renderings, RFC 8414 issuer, token audience, SPIFFE trust domain.
GATEWAY_BASE_URL=https://id.vector.apexfusion.org
# Text that /policy publishes on the retention of the web proxy's access log.
ACCESS_LOG_RETENTION=
# Background fetch jobs (protocol detection, domain linkage): on or off; seconds between scans (60-86400).
FETCH_JOBS=on
FETCH_SCAN_INTERVAL_S=600
# M4 services: both gateway key files (PEM, mode 600, readable only by the container user) and the gateway's
# own identifier. Without the key files the M4 services are off and agent cards answer 503.
GATEWAY_ED25519_KEY_FILE=
GATEWAY_P256_KEY_FILE=
GATEWAY_VECTOR_ID=
# Delegation contract (policy ID = script hash). DELEGATION_ADDRESS defaults to its enterprise address.
DELEGATION_POLICY_ID=
DELEGATION_ADDRESS=
# Seconds that built status lists are used (1-3600).
STATUS_LIST_REFRESH_SECONDS=60
