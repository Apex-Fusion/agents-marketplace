# identity-gateway runtime settings. All are optional; the values below are the defaults.
# Identity registry values are published at its deployment. A deployed registry needs both
# IDENTITY_POLICY_ID and CUTOFF_SLOT. IDENTITY_ADDRESS defaults to the enterprise address of the policy.
IDENTITY_POLICY_ID=
IDENTITY_ADDRESS=
CUTOFF_SLOT=
LEGACY_POLICY_ID=be1a0a2912da180757ed3cd61b56bb8eab0188c19dc3c0e3912d2c01
LEGACY_ADDRESS=addr1wxlp5z3fztdpsp6ha57dvx6khw82kqvgcxwu8s8rjykjcqghprf42
# Vector mainnet genesis values. The resolver compares them with the values Koios reports.
GENESIS_NETWORK_MAGIC=764824073
GENESIS_SYSTEM_START=2025-08-29T16:40:00Z
GENESIS_SLOT_LENGTH=1
GENESIS_SECURITY_PARAM=2160
KOIOS_URL=https://v2.koios.vector.mainnet.apexfusion.org/api/v1
# Koios bearer token, if the Koios instance needs one. Do not commit a real token.
KOIOS_TOKEN=
OGMIOS_URL=wss://ogmios.vector.mainnet.apexfusion.org
HOST=127.0.0.1
PORT=8080
