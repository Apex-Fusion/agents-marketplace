# identity-gateway runtime settings. All are optional; the values below are the defaults.
# Identity registry values are published at its deployment. A deployed registry needs both
# IDENTITY_POLICY_ID and CUTOFF_SLOT. IDENTITY_ADDRESS defaults to the enterprise address of the policy.
IDENTITY_POLICY_ID=d958b823faaa76977d0a07bd9622e87d8e2c85f6692f7f8e8db77762
IDENTITY_ADDRESS=addr1w8v43wprl248d9mapgrmm93zap7cuty97e5j7luw3kmhwcs8vm9vk
CUTOFF_SLOT=37218553
LEGACY_POLICY_ID=be1a0a2912da180757ed3cd61b56bb8eab0188c19dc3c0e3912d2c01
LEGACY_ADDRESS=addr1wxlp5z3fztdpsp6ha57dvx6khw82kqvgcxwu8s8rjykjcqghprf42
# Vector mainnet genesis values. The resolver compares them with the values Koios reports.
GENESIS_NETWORK_MAGIC=764824073
GENESIS_SYSTEM_START=2025-08-29T16:40:00Z
GENESIS_SLOT_LENGTH=1
GENESIS_SECURITY_PARAM=2160
KOIOS_URL=https://v2.koios.vector.mainnet.apexfusion.org/api/v1
# Koios bearer token, if the Koios instance needs one. Do not commit a real token.
KOIOS_TOKEN=
# Koios calls per second on average, in bursts of twice as many (1-100). Koios refuses about 300 requests in 10 s.
KOIOS_RATE_PER_SECOND=10
OGMIOS_URL=wss://ogmios.vector.mainnet.apexfusion.org
HOST=127.0.0.1
PORT=8080
# Public HTTPS origin of the gateway, the only base URL: renderings, RFC 8414 issuer, token audience, SPIFFE trust domain.
GATEWAY_BASE_URL=https://id.vector.apexfusion.org
# Text that /policy publishes on the retention of the web proxy's access log.
ACCESS_LOG_RETENTION=
# Background fetch jobs (protocol detection, domain linkage): on or off; seconds between scans (60-86400).
FETCH_JOBS=on
FETCH_SCAN_INTERVAL_S=600
# M4 services: both gateway key files (PEM, mode 600, readable only by the container user) and the gateway's
# own identifier. Without the key files the M4 services are off and agent cards answer 503.
GATEWAY_ED25519_KEY_FILE=
GATEWAY_P256_KEY_FILE=
GATEWAY_VECTOR_ID=
# Delegation contract (policy ID = script hash). DELEGATION_ADDRESS defaults to its enterprise address.
DELEGATION_POLICY_ID=bdc16990b844a8860f28c51bb0e6a469c84bebcd57db699ce204785a
DELEGATION_ADDRESS=addr1wx7uz6vshpz23ps09rz3hv8x535usjlte4tak6vuugz8sks9wdc5c
# Attestation contract (policy ID = script hash). ATTESTATION_ADDRESS defaults to its enterprise address. Without the
# policy ID, the DID document metadata has no vectorProvenance.
ATTESTATION_POLICY_ID=f07c644e042ead094cc501f443e03a8955dc1f4d0dcd5b387863e042
ATTESTATION_ADDRESS=addr1w8c8cezwqsh26z2vc5qlgslq82y4thqlf5xu6kec0p37qssut0y3q
# Seconds between the background checks of the attestation outputs (10-60). A check makes one Koios call for the tip.
# When the tip is new, it makes one more call: a question for transactions at the attestation address. Only when there
# is one, the check reads the outputs: two more calls, and one more call for each further 1,000 outputs. With no
# change that is 2 calls for each check, at most 5,760 calls in a day at 30 s. A read stops at once when more than 5,000
# outputs exist, and the next try waits 10 minutes. A request makes no call.
ATTESTATION_REFRESH_SECONDS=30
# Status list timing, in seconds. A list is valid for 3600 s after the block time of the tip that its bits
# describe. An interval plus 1200 s for the check of the timer and for a build must fit in that time, so each
# interval is at most 2400 s (see the README).
# A request builds the lists again when no build and no follow step has read the chain for this long (1-2400;
# two follow intervals, when that is longer). It is also the ttl of the lists.
STATUS_LIST_REFRESH_SECONDS=60
# The timer starts a full build when the last build ended this long ago, with no request (60-2400, not below
# the value above).
STATUS_LIST_BACKGROUND_REFRESH_SECONDS=600
# The timer reads the changes of the chain into the lists every this many seconds (0, or a multiple of 10 up to 300).
# With 0, the lists change only when a build ends.
STATUS_LIST_FOLLOW_SECONDS=10
