# indexer/.env.example
#
# Copy to indexer/.env and fill in. .env is gitignored — never commit.
# The indexer holds NO secrets; it only reads from chain.

# ─── Required ─────────────────────────────────────────────────────────────

# Ogmios WebSocket URL — same hosted endpoint as the supplier.
OGMIOS_URL=wss://ogmios.vector.testnet.apexfusion.org

# SQLite database file. The compose volume `indexer_data` is mounted at
# /repo/indexer/data, so DB_PATH must live under that prefix to persist.
DB_PATH=/repo/indexer/data/indexer.db

# 0 = Vector testnet, 1 = Vector mainnet
# Standardized 2026-04-27 (M1-F-1) across all services — see ARCHITECTURE.md
# §9. Legacy "testnet"/"mainnet" labels are now rejected by loadConfig.
NETWORK_ID=0

# ─── Optional ─────────────────────────────────────────────────────────────

# HTTP listen port (default 8090).
INDEXER_PORT=8090

# Status poll interval (ms) for the supplier /status endpoint (default 20s).
STATUS_POLL_MS=20000

# Skip blocks before this slot — fast-forward the chain-sync past pre-deploy
# history. Set to the slot where the marketplace contracts were deployed on
# Vector testnet. Bumping this on an existing DB is idempotent (saved cursor
# wins). 0 disables.
SKIP_BEFORE_SLOT=0

# GET /healthz reports ok: false when the indexer is more slots than this
# behind the chain tip that Ogmios reports (default 600; 1 slot = 1 s on Vector).
# MAX_SYNC_LAG_SLOTS=600

# ─── Watched contracts ────────────────────────────────────────────────────
# Legacy advert + escrow script addresses. Unset: not watched. Keep them set
# during the drain (Part 2 §9.6): legacy escrows stay readable until none is left.
# ADVERT_SCRIPT_ADDRESS=
# ESCROW_SCRIPT_ADDRESS=

# ─── Identity registry (Part 2 §6.4) ──────────────────────────────────────
# Set all four, or none (none = the state before the identity deployment).
# IDENTITY_POLICY_ID=d958b823faaa76977d0a07bd9622e87d8e2c85f6692f7f8e8db77762
# IDENTITY_ADVERT_SCRIPT_ADDRESS=addr1w8ekudnwqm2yspj34g8pqezh3u9luf66l9kle24tuhh7ymqljqmvd
# IDENTITY_ESCROW_SCRIPT_ADDRESS=addr1wx7asmv6c8n09mmte7quz3fzlp4d5x6r3jn6urysepzem6cdcfuk3
# IDENTITY_GATEWAY_URL=http://identity-gateway:8080
#
# Optional. IDENTITY_ADDRESS defaults to (and must equal) the enterprise
# address of IDENTITY_POLICY_ID on NETWORK_ID.
# IDENTITY_ADDRESS=addr1w8v43wprl248d9mapgrmm93zap7cuty97e5j7luw3kmhwcs8vm9vk
# Ask the gateway again after this many ms (1000 ≤ value < 600000).
# IDENTITY_REFRESH_MS=60000
# Switch slot (Part 2 §9.6). Before it, legacy adverts stay listed with
# agent_id null; from it on, only listed new adverts appear.
# SWITCH_SLOT=

# ─── Backfill for the release that adds identity support (Part 2 §6.4) ───
# Use one of the two. Without a backfill, records registered before this
# indexer watched the identity address stay unknown and their adverts are
# never listed.
# (a) Load the current outputs at the identity address from Ogmios at each
#     start (HTTP JSON-RPC on the OGMIOS_URL port).
# IDENTITY_LOAD_AT_START=1
# (b) Sync again from a block before the identity deployment (once per point;
#     the slot must not be below SKIP_BEFORE_SLOT).
# RESYNC_FROM_SLOT=
# RESYNC_FROM_BLOCK_HASH=
#
# The same two variables recover a follower that lost its intersection
# (GET /healthz follower "no_intersection"; the log names RESYNC_FROM_*): the
# node has none of the last 100 blocks that the indexer saved. Set them to a
# block of the current chain before the slot in the log (Koios /blocks gives
# slot and hash) and restart. The indexer removes all state after that block
# and reads the later blocks again. It never syncs again from the origin by
# itself.
