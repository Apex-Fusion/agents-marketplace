# supplier/.env.example
#
# Copy to supplier/.env and fill in real values before `docker compose up`.
# .env is gitignored — NEVER commit a populated copy.
#
# Generate a fresh Ed25519 wallet with the supplier keypair CLI. Use this file
# for local configuration checks first. The current testnet has no functional
# end-to-end marketplace.
#
# Lines marked SECRET must never be shared, logged, or committed.

# ─── Required ─────────────────────────────────────────────────────────────

# 64-char hex Ed25519 private key seed for the supplier wallet. SECRET.
# Generate via: openssl rand -hex 32
SUPPLIER_PRIV_KEY_HEX=PASTE_64_HEX_CHARS_HERE

# Ogmios WebSocket URL. For external hosted Ogmios (recommended for M1-F):
#     wss://ogmios.vector.testnet.apexfusion.org
# For a local Ogmios container (M1-F-vector-stack follow-up): ws://ogmios:1337
OGMIOS_URL=wss://ogmios.vector.testnet.apexfusion.org

# Legacy Ollama adapter URL. It supports plain text only and rejects unsupported
# tools or reasoning. For production Ollama native Responses, use
# LLM_BACKEND=openai, OPENAI_UPSTREAM_API=responses, and set OPENAI_BASE_URL to
# the Ollama HTTP root instead.
OLLAMA_URL=http://ollama:11434

# OutputReference of this supplier's on-chain advertisement UTxO.
# Format: "<64-hex-tx-hash>#<int-output-index>"
# Posting an advert is a one-shot operation. See deploy/README.md.
ADVERT_REF=PASTE_TXHASH_HERE#0

# Cardano network ID. "0" = testnet, "1" = mainnet. Select it together with
# the matching Ogmios URL, advert, reference scripts, and wallet.
NETWORK_ID=0

# ─── Optional ─────────────────────────────────────────────────────────────

# HTTP listen port inside the container. Compose maps this to the host.
PORT=8080

# Ollama request timeout (ms). Tiny CPU model on Hetzner CX is slow — keep
# generous. Increase if you see ollama_timeout reasons in logs.
OLLAMA_TIMEOUT_MS=120000

# ─── Optional — OpenAI-compatible backend (LLM_BACKEND=openai) ────────────
# Native Responses is the default upstream protocol. Set the mode explicitly
# in operator examples. There is no automatic HTTP fallback.
# LLM_BACKEND=openai
# OPENAI_UPSTREAM_API=responses
# OPENAI_BASE_URL=https://openrouter.ai/api
# OPENAI_TIMEOUT_MS=180000

# The native adapter appends /v1/responses to OPENAI_BASE_URL. Use an exact
# full endpoint only when the provider needs one.
# OPENAI_RESPONSES_URL=https://api.deepseek.com/responses

# Some native backends, including the pinned Codex proxy for gpt-5.6-sol,
# return complete output only through SSE. Literal "1" collects that stream
# even for a buffered supplier call. Complete output_item.done Items are
# authoritative; partial deltas are not reconstructed.
# OPENAI_RESPONSES_STREAM_ONLY=

# Compatibility mode appends /v1/chat/completions. Keep it explicit for
# Hetzner, unupgraded local llama.cpp, and OpenClaw endpoints.
# OPENAI_UPSTREAM_API=chat-completions

# Optional reasoning policy. "off", "false", "0", or "no" disables reasoning.
# Native mode sends reasoning.effort="none". Chat mode sends the OpenRouter
# reasoning.enabled=false extension, which Hetzner and HF Chat reject.
# OPENAI_REASONING=

# Optional operator output ceiling. Buyer max_output_tokens and the advert cap
# still apply. Unset means no operator ceiling.
# OPENAI_MAX_TOKENS=

# Optional bearer token. Hosted APIs require it. Local unauthenticated
# endpoints can leave it empty. SECRET.
# OPENAI_API_KEY=

# ─── Supplier wallet identity ─────────────────────────────────────────────
# Generate these with tx:gen-keypair. Keep every value from the same key.
# The private seed above is secret. The public values are still required for
# escrow ownership checks.
SUPPLIER_PUB_KEY_HEX=PASTE_32_BYTE_HEX_HERE
SUPPLIER_PKH=PASTE_28_BYTE_HEX_HERE
SUPPLIER_ADDRESS=PASTE_ADDR_HERE

# ─── Optional — chain provider selection (M1-F-2) ─────────────────────────
# LIVE_CHAIN: opt-in to real Ogmios submitTx + awaitTx.
# Default unset = ReadOnlyOgmiosProvider (no real chain writes; safe for dev).
# Set to literal "1" to enable LiveOgmiosProvider — REAL TESTNET/MAINNET
# SUBMISSIONS WILL HAPPEN. Any other value (including "true", "yes", "TRUE")
# is treated as off, by design (safety against misconfiguration).
LIVE_CHAIN=

# ─── tx:post-advert — run once before first deploy (M1-F-3) ───────────────────
# Execute: pnpm --filter @marketplace/supplier tx:post-advert
# On success, copy the printed "<txHash>#0" string into ADVERT_REF above.

# Capability published in the on-chain advertisement.            // added M1-F-3
ADVERT_CAPABILITY_ID=llm.text.generate.v1

# Ollama model name served by this supplier.                     // added M1-F-3
ADVERT_MODEL=qwen2.5:0.5b

# Maximum output tokens the supplier will honour per request.    // added M1-F-3
ADVERT_MAX_OUTPUT_TOKENS=512

# Maximum processing time the supplier guarantees (ms).          // added M1-F-3
ADVERT_MAX_PROCESSING_MS=60000

# Flat price per prompt in AP3X lovelace.                        // added M1-F-3
ADVERT_PRICE_LOVELACE=2000000

# Supplier bond deposited into the advert UTxO (lovelace).       // added M1-F-3
# Default 1_000_000 if omitted.
ADVERT_SUPPLIER_BOND_LOVELACE=1000000

# Buyer bond required per escrow (lovelace).                     // added M1-F-3
# Default 1_000_000 if omitted.
ADVERT_BUYER_BOND_LOVELACE=1000000

# HTTPS endpoint buyers will call (must be publicly reachable).  // added M1-F-3
ADVERT_ENDPOINT_URL=https://mp-supplier.vector.testnet.apexfusion.org

# Optional off-chain detail pointer (IPFS / HTTPS URI).          // added M1-F-3
# Leave empty for v1 if no extended metadata is published.
ADVERT_DETAIL_URI=

# Optional sha256 of the detail JSON (64 hex chars).             // added M1-F-3
# If empty, defaults to sha256("") =
# e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
ADVERT_DETAIL_HASH=

# ─── Optional: CIP-33 reference scripts ───────────────────────────────────
# Saves witness-set fee on script-spending txs (Claim, Submit, Accept,
# Reclaim, RetireAdvert) by referencing on-chain script UTxOs instead of
# inlining the full validator CBOR. Leave unset to use inlined scripts
# (current behavior).
#
# Publish the two reference UTxOs (one-shot; uses SUPPLIER_PRIV_KEY_HEX +
# OGMIOS_URL + NETWORK_ID from this env file):
#   docker compose -f deploy/testnet/docker-compose.supplier.yml run --rm \
#     --entrypoint sh supplier \
#     -c "node_modules/.bin/tsx supplier/src/cli/publish-reference-scripts.ts"
# Paste the two printed refs here AND into buyer/.env, then
# `docker compose down && up -d` to apply.
# ESCROW_REF_UTXO=<txhash>#0
# ADVERT_REF_UTXO=<txhash>#1

# ─── Optional: chat-session tuning (CAPABILITY_KIND=chat-session only) ─────
# CHAT_IDLE_TIMEOUT_MS=300000  # auto-end sessions idle this long
# MAX_CHAT_SESSIONS=1          # concurrent session slots (default 1)
# CHAT_SETTLE_MODE=full        # "full" (Claim/Submit) or "ticket" (no supplier
#                              # chain ops; buyer reclaims the Open escrow)

# ─── Autonomous Surplus seller (surplus:start) ────────────────────────────
# This service uses a seller-scoped Surplus key. It does not need a wallet
# private key. Keep both API keys in the host-only surplus-seller.env file.
SURPLUS_LIVE=
SURPLUS_API_URL=https://api.surplusintelligence.ai
SURPLUS_SELLER_API_KEY=si_seller_REPLACE_ME
SURPLUS_OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
SURPLUS_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CAPACITY_BASE_URL=https://openrouter.ai/api
SURPLUS_SELLER_WALLET=0x0000000000000000000000000000000000000000
SURPLUS_PAYOUT_ADDRESS=0x0000000000000000000000000000000000000000
# The controller discovers all fixed-price text models and selects one by
# current demand. It keeps only one active offer. At the default 490 bps
# recovery floor, a $0.05 seller cap bounds upstream spend near $1.02 per day.
SURPLUS_PER_OFFER_CAP_USD=0.05
SURPLUS_AGGREGATE_CAP_USD=0.05
SURPLUS_OPENROUTER_RESERVE_USD=1.00
SURPLUS_OPENROUTER_MAX_LIMIT_USD=20.00
SURPLUS_MIN_RECOVERY_BPS=490
SURPLUS_UNDERCUT_BPS=10
SURPLUS_MAX_CANDIDATE_ORDER_BOOKS=10
SURPLUS_REPRICE_INTERVAL_MS=300000
SURPLUS_REQUEST_TIMEOUT_MS=120000
# 0 keeps selling. 1 pauses after the first trade or one offer-cap of spend.
SURPLUS_STOP_AFTER_SETTLED_REQUESTS=0
SURPLUS_SETTLED_STATUSES=confirmed
SURPLUS_STATE_PATH=/var/lib/surplus-manager/state.json
# --- Vector proof publisher ------------------------------------------------
# When enabled, every settled Base settlement transaction gets one Vector
# counterpart: the sales it settled are Merkle-batched and anchored in a
# label-674 metadata transaction signed by the proof wallet below.
SURPLUS_PROOF_ENABLED=
# Required when enabled. Mainnet Ogmios endpoint and the 64-hex Ed25519 key
# of the AP3X proof wallet (the retired Vector supplier wallet).
OGMIOS_URL=
SURPLUS_PROOF_WALLET_PRIV_KEY_HEX=
SURPLUS_PROOF_LEDGER_PATH=/var/lib/surplus-manager/vector-proofs.json
# Anchoring pauses when the wallet cannot keep this reserve after one fee.
SURPLUS_PROOF_RESERVE_LOVELACE=5000000
SURPLUS_PROOF_FEE_BUDGET_LOVELACE=1000000
SURPLUS_PROOF_INTERVAL_MS=300000
SURPLUS_PROOF_CONFIRM_TIMEOUT_MS=300000
# Optional support-export backfill. The CSV must have the exact header:
# request_id,settled_at,model,input_tokens,output_tokens,seller_earned_usd,settlement_status,settlement_type,tx_hash
# The offer id is stamped into each export leaf because the export omits it.
SURPLUS_PROOF_HISTORY_CSV_PATH=
SURPLUS_PROOF_HISTORY_OFFER_ID=
