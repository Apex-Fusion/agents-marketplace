# gateway/.env.example — copy to .env and fill in.

# 32-byte (64 hex char) master key used to AES-256-GCM-encrypt every user's
# custodial wallet private key at rest. Generate with: openssl rand -hex 32
# LOSING THIS PERMANENTLY LOCKS ALL USER FUNDS. Back it up out-of-band.
GATEWAY_MASTER_KEY=

# Server-only token for GET /internal/api-keys. Generate a separate random token:
# openssl rand -hex 32
# Set the SAME value in buyer/.env. Never use GATEWAY_MASTER_KEY here.
# At least 32 chars; leaving it empty disables the operator key list.
GATEWAY_ADMIN_TOKEN=

# Internal indexer base URL (e.g. http://marketplace-indexer:8090).
INDEXER_URL=

# Ogmios HTTP endpoint. Required (the gateway posts/settles escrows on chain).
OGMIOS_URL=

# Must be "1" — the gateway signs and submits real transactions.
LIVE_CHAIN=1

# "0" testnet (addr_test…), "1" mainnet (addr…). Default "0".
NETWORK_ID=0

# HTTP port. Default 3010.
GATEWAY_PORT=3010

# Directory holding gateway.db (keys, usage, sessions, jobs, wallet transaction journal). BACK IT UP.
# Default ./data/gateway
GATEWAY_DB_DIR=./data/gateway

# Shared secret for free Paper2Agent tool calls. The gateway sends it to the
# publisher's POST /p2a/tools/<id>/v1/paper2agent/call route. Set the SAME
# value in the publisher's environment. At least 32 chars; generate with:
# openssl rand -hex 32. Empty: /mcp still lists tools, but tools/call fails.
PAPER2AGENT_TOOL_CALL_TOKEN=
# The publisher's PAPER2AGENT_PUBLISHER_PUBLIC_URL. Required with the token:
# /mcp lists and calls only tools whose advert endpoint is under <url>/tools/.
PAPER2AGENT_PUBLISHER_PUBLIC_URL=https://api.marketplace.vector.apexfusion.org/p2a

# Identity registry (Part 2 §6, §9.6). Published at the identity deployment;
# leave empty before it (the gateway then settles legacy escrows only).
# IDENTITY_POLICY_ID: 56 lowercase hex, the identity registry policy ID. The
# gateway checks the identity blueprint at boot when it is set.
IDENTITY_POLICY_ID=d958b823faaa76977d0a07bd9622e87d8e2c85f6692f7f8e8db77762
# <txHash>#<index> of the new escrow reference script (unset: inline script).
# Keep ESCROW_REF_UTXO for the legacy escrows until the drain ends.
IDENTITY_ESCROW_REF_UTXO=4c2d09858dab0cc22cc77dcb99efed570d909a66e0beb512041dea91005b5e82#0
# Escrow switch slot, the same value as the indexer's SWITCH_SLOT. From this
# chain slot on, the gateway routes only new adverts (agent_id set).
SWITCH_SLOT=

# Optional tuning (defaults shown):
# SIGNUP_RATE_MAX=5            # signups per IP per window
# SIGNUP_RATE_WINDOW_MS=3600000
# KEY_RATE_MAX=60             # requests per API key per window
# KEY_RATE_WINDOW_MS=60000
# SWEEPER_INTERVAL_MS=60000
# DEMO_SESSION_IDLE_MS=180000 # close demo chat sessions idle this long (frees the supplier slot)
# CHAT_SETTLE_MODE=full       # "full" (Claim/Submit/Accept) or "ticket" (escrow post only; sweeper reclaims) — must match suppliers
# WALLET_HEALTH_INTERVAL_MS=600000
# SDK_REGISTRY_MAX=500        # max cached per-key Marketplace instances
# ONE_SHOT_CONCURRENCY=4       # active paid LLM jobs per key
# ONE_SHOT_MAX_OUTSTANDING=64  # queued + active + recovering jobs per key
# ONE_SHOT_QUEUE_TIMEOUT_MS=60000 # admission wait before funding; overflow returns 429
# Public /mcp (no API key; limits per client IP and per gateway):
# MCP_IP_RATE_MAX=120          # /mcp requests per IP per window
# MCP_IP_RATE_WINDOW_MS=60000
# MCP_CALL_IP_RATE_MAX=20      # tools/call per IP per window
# MCP_CALL_IP_RATE_WINDOW_MS=60000
# MCP_CALL_IP_CONCURRENCY=1    # tools/call in flight per IP
# MCP_CALL_CONCURRENCY=2       # tool calls in flight for the gateway (one per tool supplier)
# MCP_CALL_QUEUE_TIMEOUT_MS=60000 # wait for a free tool slot; then the call reports busy
# MCP_CATALOG_TTL_MS=30000     # cache time of the tools/list catalog
